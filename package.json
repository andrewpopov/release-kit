{
  "name": "@andrewpopov/release-kit",
  "version": "0.1.4",
  "description": "Reusable release/patch-note toolkit: alpha and stable semver strategies, fragment-based patch notes, release cut/publish/validate, and release-hygiene enforcement. Consumers inject all policy (paths, kinds, wording) via a small config.",
  "author": "Andrew Popov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewpopov/release-kit.git"
  },
  "bugs": {
    "url": "https://github.com/andrewpopov/release-kit/issues"
  },
  "homepage": "https://github.com/andrewpopov/release-kit#readme",
  "keywords": [
    "release",
    "semver",
    "changelog",
    "patch-notes",
    "cli",
    "typescript"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "release-kit": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:pack": "node scripts/verify-pack.mjs",
    "verify:dist-fresh": "node scripts/verify-dist-fresh.mjs",
    "verify:tag": "node scripts/verify-release-tag.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run verify:pack && npm audit --omit=dev --audit-level=high"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}
